<ui:FluentWindow
    x:Class="StrPdf.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About"
    Width="440" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource BandBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <ui:TitleBar Title="About" Background="Transparent" ShowMinimize="False" ShowMaximize="False" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,20">
            <StackPanel Orientation="Horizontal">
                <!--  Inline vector mark instead of the .ico: WPF picks the .ico's smallest embedded
                     frame and stretches it regardless of the requested size, which blurs badly at 40px.  -->
                <Viewbox Width="40" Height="40">
                    <Canvas Width="1080" Height="1080">
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M146.3,319.6l125.8,43.4,18.3,29.9v55.4l-45.8,45.8h-102.7l-60.8-20.3,16.4-48.7,55,18.3h67l15.4-15.4v-11.1l-6.7-11.1-125.8-43.4-18.3-29.9v-54.5l45.8-45.8h103.2l60.8,20.3-16.4,48.7-55-18.3h-67.5l-15.4,15.4v10.1l6.8,11.1Z" />
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M315.5,287.8v-50.6h43.4v-70.9h55.4v70.9h69.9v50.6h-69.9v140.8l14.9,14.9h32.3l52.6-16.4,14.9,47.7-61.7,19.3h-62.7l-45.8-45.8v-160.6h-43.4Z" />
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M621.2,313.4v180.8h-55.4v-194.3l-14.9-61.2,44.8-11.1,9.2,37.1,28-32.3h80l56.9,55.4-36.6,37.6-43.4-42.4h-41.9l-26.5,30.4Z" />
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M716.7,483.6v-26.5l17.8-17.8h26.5l17.8,17.8v26.5l-17.8,17.8h-26.5l-17.8-17.8Z" />
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M482.1,633.4l46.3,45.8v170.2l-46.3,45.8h-85.3l-26-18.8v99.8h-55.4v-275.3l-14.9-61.2,44.8-11.1,9.2,37.1,28-32.3h99.8ZM370.7,714.4v108l30.9,22.2h56.4l14.9-14.9v-130.7l-14.9-14.9h-60.8l-26.5,30.4Z" />
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M608.4,895.2l-46.3-45.8v-170.2l46.3-45.8h85.3l26,18.8v-99.3h55.4v274.8l14.9,61.2-44.8,11.1-9.2-37.1-28,32.3h-99.8ZM719.8,814.2v-108l-30.9-22.2h-56.4l-14.9,14.9v130.7l14.9,14.9h60.8l26.5-30.4Z" />
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M903.5,552.9h62.7l61.7,19.3-14.9,47.7-52.6-16.4h-32.3l-14.9,14.9v43.9h69.9v50.6h-69.9v182.3h-55.4v-182.3h-43.4v-50.6h43.4v-63.6l45.8-45.8Z" />
                    </Canvas>
                </Viewbox>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Copyright © str.ucture GmbH" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                       Text="Offline PDF/A conversion (Ghostscript) with independent conformance validation (veraPDF)." />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="For internal use at str.ucture GmbH. Free software under the GNU AGPL v3, provided without any warranty or liability." />
            <ui:HyperlinkButton Margin="0,4,0,0" Padding="0" Content="License and notices" Click="OnLicense" />

            <DockPanel Margin="0,16,0,0">
                <ui:Button DockPanel.Dock="Right" Width="34" Padding="0" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy email" Click="OnCopyEmail" />
                <TextBlock Style="{StaticResource InfoLabel}" Text="Contact: " />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="info@str-ucture.com" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <ui:Button DockPanel.Dock="Right" Width="34" Padding="0" Icon="{ui:SymbolIcon Open24}" ToolTip="Open website" Click="OnOpenWebsite" />
                <TextBlock Style="{StaticResource InfoLabel}" Text="Website: " />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="str-ucture.com" />
            </DockPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
