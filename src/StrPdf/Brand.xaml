<!--  Brand color tokens: the app's own accent/status colors, as opposed to the
     WPF-UI Fluent theme brushes (Accent*Brush, TextFillColor*Brush, etc.) which
     already come from ui:ThemesDictionary. Change a color once here; every
     Setter and per-button hover override below reads it by name.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandPinkColor">#FF3EB5</Color>
    <Color x:Key="BrandPinkHoverColor">#D9359A</Color>
    <SolidColorBrush x:Key="BrandPinkBrush" Color="{StaticResource BrandPinkColor}" />
    <SolidColorBrush x:Key="BrandPinkHoverBrush" Color="{StaticResource BrandPinkHoverColor}" />

    <Color x:Key="BrandDangerColor">#C42B1C</Color>
    <Color x:Key="BrandDangerHoverColor">#A72518</Color>
    <SolidColorBrush x:Key="BrandDangerBrush" Color="{StaticResource BrandDangerColor}" />
    <SolidColorBrush x:Key="BrandDangerHoverBrush" Color="{StaticResource BrandDangerHoverColor}" />

    <Color x:Key="BrandTertiaryColor">#3EC6FF</Color>
    <Color x:Key="BrandTertiaryHoverColor">#2FA8D9</Color>
    <SolidColorBrush x:Key="BrandTertiaryBrush" Color="{StaticResource BrandTertiaryColor}" />
    <SolidColorBrush x:Key="BrandTertiaryHoverBrush" Color="{StaticResource BrandTertiaryHoverColor}" />

</ResourceDictionary>
