<ui:FluentWindow
    x:Class="StrPdf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PDF to PDF/A Converter"
    Width="1100" Height="760" MinWidth="880" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    WindowCornerPreference="Round"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    PreviewKeyDown="OnWindowKey"
    Closing="OnClosing">

    <ui:FluentWindow.Resources>
        <!--  A raised, outlined surface: solid fill over the darker window base so sections stand apart.  -->
        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!--  One height for every button, icon-only or not, so rows line up.  -->
        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  Fill colors: each sets its own hover/pressed brush via Style.Resources, which WPF-UI's
             ui:Button template reads by DynamicResource key (ButtonBackgroundPointerOver/Pressed).
             One place per color to change, instead of repeating the override on every button.  -->
        <Style x:Key="PrimaryFillButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Style.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BrandPinkHoverColor}" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BrandPinkHoverColor}" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            </Style.Resources>
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BrandPinkBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="DangerFillButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Style.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BrandDangerHoverColor}" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BrandDangerHoverColor}" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            </Style.Resources>
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BrandDangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="TertiaryFillButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Style.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BrandTertiaryHoverColor}" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BrandTertiaryHoverColor}" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            </Style.Resources>
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BrandTertiaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  WPF-UI's TitleBar hardcodes its own icon slot to 16px tall, so a bigger icon is
             drawn here instead, on top. The native Icon stays set but invisible (Opacity 0) so
             it still reserves its normal 16px-icon-sized layout slot - the title text's position
             is calculated from that slot, so removing the icon entirely shifts the text left into
             where the bigger icon sits. Overlay is non-hit-testable so clicks/drags still reach
             the title bar underneath.  -->
        <Grid Grid.Row="0">
            <ui:TitleBar x:Name="AppTitleBar" Background="{DynamicResource BandBrush}" Title="PDF to PDF/A Converter" FontSize="16" FontWeight="SemiBold">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/str.ico" Opacity="0" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
            <Viewbox Width="20" Height="20" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="1080" Height="1080">
                    <Path Fill="{StaticResource BrandPinkBrush}" Data="M146.3,319.6l125.8,43.4,18.3,29.9v55.4l-45.8,45.8h-102.7l-60.8-20.3,16.4-48.7,55,18.3h67l15.4-15.4v-11.1l-6.7-11.1-125.8-43.4-18.3-29.9v-54.5l45.8-45.8h103.2l60.8,20.3-16.4,48.7-55-18.3h-67.5l-15.4,15.4v10.1l6.8,11.1Z" />
                    <Path Fill="{StaticResource BrandPinkBrush}" Data="M315.5,287.8v-50.6h43.4v-70.9h55.4v70.9h69.9v50.6h-69.9v140.8l14.9,14.9h32.3l52.6-16.4,14.9,47.7-61.7,19.3h-62.7l-45.8-45.8v-160.6h-43.4Z" />
                    <Path Fill="{StaticResource BrandPinkBrush}" Data="M621.2,313.4v180.8h-55.4v-194.3l-14.9-61.2,44.8-11.1,9.2,37.1,28-32.3h80l56.9,55.4-36.6,37.6-43.4-42.4h-41.9l-26.5,30.4Z" />
                    <Path Fill="{StaticResource BrandPinkBrush}" Data="M716.7,483.6v-26.5l17.8-17.8h26.5l17.8,17.8v26.5l-17.8,17.8h-26.5l-17.8-17.8Z" />
                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M482.1,633.4l46.3,45.8v170.2l-46.3,45.8h-85.3l-26-18.8v99.8h-55.4v-275.3l-14.9-61.2,44.8-11.1,9.2,37.1,28-32.3h99.8ZM370.7,714.4v108l30.9,22.2h56.4l14.9-14.9v-130.7l-14.9-14.9h-60.8l-26.5,30.4Z" />
                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M608.4,895.2l-46.3-45.8v-170.2l46.3-45.8h85.3l26,18.8v-99.3h55.4v274.8l14.9,61.2-44.8,11.1-9.2-37.1-28,32.3h-99.8ZM719.8,814.2v-108l-30.9-22.2h-56.4l-14.9,14.9v130.7l14.9,14.9h60.8l26.5-30.4Z" />
                    <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M903.5,552.9h62.7l61.7,19.3-14.9,47.7-52.6-16.4h-32.3l-14.9,14.9v43.9h69.9v50.6h-69.9v182.3h-55.4v-182.3h-43.4v-50.6h43.4v-63.6l45.8-45.8Z" />
                </Canvas>
            </Viewbox>
        </Grid>

        <!--  Toolbar band, distinct from the title bar above it  -->
        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" />

        <DockPanel Grid.Row="1" Margin="16,8,16,8" LastChildFill="False">
            <ui:Button x:Name="AddButton" Style="{StaticResource PrimaryFillButton}" Content="Add PDFs" Icon="{ui:SymbolIcon DocumentAdd24}" ToolTip="Add PDF files (Ctrl+O)" Click="OnAddFiles" />
            <ui:Button x:Name="FolderButton" Style="{StaticResource PrimaryFillButton}" Margin="8,0,0,0" Content="Add folder" Icon="{ui:SymbolIcon FolderAdd24}" ToolTip="Add a folder of PDFs (Ctrl+Shift+O)" Click="OnAddFolder" />
            <CheckBox x:Name="SubfoldersBox" Margin="12,0,0,0" VerticalAlignment="Center" Content="Include subfolders"
                      ToolTip="Also applies to folders already added to the list." Checked="OnSubfoldersChanged" Unchecked="OnSubfoldersChanged">
                <CheckBox.Resources>
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource BrandPinkColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource BrandPinkColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource BrandPinkColor}" />
                </CheckBox.Resources>
            </CheckBox>

            <ui:Button x:Name="MoreButton" DockPanel.Dock="Right" Margin="8,0,0,0" Width="34" Padding="0"
                       Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="Theme, about, and license" AutomationProperties.Name="More" Click="OnMore">
                <ui:Button.ContextMenu>
                    <ContextMenu>
                        <ui:MenuItem x:Name="ThemeMenu" Header="Theme" Icon="{ui:SymbolIcon DarkTheme24}">
                            <ui:MenuItem x:Name="ThemeSystem" Header="Use system setting" Tag="System" Icon="{ui:SymbolIcon DarkTheme24}" Click="OnThemePicked" />
                            <ui:MenuItem x:Name="ThemeLight" Header="Light" Tag="Light" Icon="{ui:SymbolIcon WeatherSunny24}" Click="OnThemePicked" />
                            <ui:MenuItem x:Name="ThemeDark" Header="Dark" Tag="Dark" Icon="{ui:SymbolIcon WeatherMoon24}" Click="OnThemePicked" />
                        </ui:MenuItem>
                        <Separator />
                        <ui:MenuItem Header="Reset to defaults" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnResetSettings" />
                        <Separator />
                        <ui:MenuItem Header="About" Icon="{ui:SymbolIcon Info24}" Click="OnAbout" />
                        <ui:MenuItem Header="License and notices" Icon="{ui:SymbolIcon Certificate24}" Click="OnLicense" />
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>
            <ui:Button x:Name="ClearButton" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource DangerFillButton}" Content="Remove all" Icon="{ui:SymbolIcon Dismiss24}" Click="OnClear" />
            <ui:Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource DangerFillButton}" Content="Remove selected" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove from the list (Delete). Files on disk are not touched." Click="OnRemove" />
        </DockPanel>

        <!--  File list  -->
        <Border Grid.Row="2" Margin="16,12,16,0" Padding="1" Style="{StaticResource Surface}">
        <Grid>
            <DataGrid
                x:Name="FileList"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                GridLinesVisibility="None"
                HorizontalScrollBarVisibility="Disabled"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                MouseDoubleClick="OnRowDoubleClick"
                PreviewKeyDown="OnListKey"
                PreviewMouseRightButtonDown="OnListRightClick"
                SelectionChanged="OnSelectionChanged"
                Background="Transparent"
                BorderThickness="0"
                RowBackground="Transparent"
                RowHeight="34">
                <DataGrid.Resources>
                    <!--  Row style: left accent bar + tinted fill when selected, subtle fill on hover, both theme-aware.  -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent" />
                                            <DataGridCellsPresenter Grid.Column="1" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" Binding="{Binding Name}" Header="File" />
                    <DataGridTextColumn Width="90" Binding="{Binding Size}" Header="Size" SortMemberPath="Bytes" />
                    <DataGridTextColumn Width="3*" Binding="{Binding Folder}" Header="Source folder" />
                    <DataGridTemplateColumn Width="170" Header="Status" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  Status pill: tinted fill + strong text, so state reads at a glance in both themes.  -->
                                <Border x:Name="Pill" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10"
                                        Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="Label" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Status}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="Ok">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Busy">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Muted">
                                        <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="2*" Header="Output file" SortMemberPath="OutputName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  On failure, OutputDisplay carries a short reason instead of a filename;
                                     styled fainter/italic/smaller so it reads as a note, not a real file name.  -->
                                <TextBlock VerticalAlignment="Center" Text="{Binding OutputDisplay}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Setter Property="ToolTip" Value="{Binding FixTip}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="110" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                    <ui:Button Width="34" Padding="0" Style="{StaticResource PrimaryFillButton}" Icon="{ui:SymbolIcon Play24}"
                                               ToolTip="Convert this file and save a copy…" Click="OnConvertRow" />
                                    <ui:Button Width="34" Margin="4,0,0,0" Padding="0" Icon="{ui:SymbolIcon DocumentText24}"
                                               IsEnabled="{Binding HasDetails}" ToolTip="View log" Click="OnViewFileLog">
                                        <ui:Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                                        <Setter Property="ToolTip" Value="No result yet" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <ui:MenuItem Header="Open output" Icon="{ui:SymbolIcon DocumentArrowRight24}" Click="OnOpen" />
                        <ui:MenuItem Header="Show in folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnReveal" />
                        <Separator />
                        <ui:MenuItem Header="Convert" Icon="{ui:SymbolIcon PlayCircle24}" Click="OnConvertSelected" />
                        <ui:MenuItem Header="Remove from list" Icon="{ui:SymbolIcon Delete24}" Click="OnRemove" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Viewbox Margin="0,40,0,0" Width="64" Height="64" HorizontalAlignment="Center">
                    <Canvas Width="1080" Height="1080">
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M146.3,319.6l125.8,43.4,18.3,29.9v55.4l-45.8,45.8h-102.7l-60.8-20.3,16.4-48.7,55,18.3h67l15.4-15.4v-11.1l-6.7-11.1-125.8-43.4-18.3-29.9v-54.5l45.8-45.8h103.2l60.8,20.3-16.4,48.7-55-18.3h-67.5l-15.4,15.4v10.1l6.8,11.1Z" />
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M315.5,287.8v-50.6h43.4v-70.9h55.4v70.9h69.9v50.6h-69.9v140.8l14.9,14.9h32.3l52.6-16.4,14.9,47.7-61.7,19.3h-62.7l-45.8-45.8v-160.6h-43.4Z" />
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M621.2,313.4v180.8h-55.4v-194.3l-14.9-61.2,44.8-11.1,9.2,37.1,28-32.3h80l56.9,55.4-36.6,37.6-43.4-42.4h-41.9l-26.5,30.4Z" />
                        <Path Fill="{StaticResource BrandPinkBrush}" Data="M716.7,483.6v-26.5l17.8-17.8h26.5l17.8,17.8v26.5l-17.8,17.8h-26.5l-17.8-17.8Z" />
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M482.1,633.4l46.3,45.8v170.2l-46.3,45.8h-85.3l-26-18.8v99.8h-55.4v-275.3l-14.9-61.2,44.8-11.1,9.2,37.1,28-32.3h99.8ZM370.7,714.4v108l30.9,22.2h56.4l14.9-14.9v-130.7l-14.9-14.9h-60.8l-26.5,30.4Z" />
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M608.4,895.2l-46.3-45.8v-170.2l46.3-45.8h85.3l26,18.8v-99.3h55.4v274.8l14.9,61.2-44.8,11.1-9.2-37.1-28,32.3h-99.8ZM719.8,814.2v-108l-30.9-22.2h-56.4l-14.9,14.9v130.7l14.9,14.9h60.8l26.5-30.4Z" />
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}" Data="M903.5,552.9h62.7l61.7,19.3-14.9,47.7-52.6-16.4h-32.3l-14.9,14.9v43.9h69.9v50.6h-69.9v182.3h-55.4v-182.3h-43.4v-50.6h43.4v-63.6l45.8-45.8Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Drop PDF files or folders here" />
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="or use Add PDFs (Ctrl+O) / Add folder (Ctrl+Shift+O)" />
            </StackPanel>
        </Grid>
        </Border>

        <!--  Options  -->
        <Grid Grid.Row="5" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Padding="16,12" Style="{StaticResource Surface}">
                <StackPanel>
                    <StackPanel.Resources>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource BrandPinkColor}" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource BrandPinkColor}" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource BrandPinkColor}" />
                    </StackPanel.Resources>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Save to" />
                    <RadioButton x:Name="NextRadio" GroupName="Save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next to the original" />
                            <TextBlock Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="(adds a &quot;_pdfa&quot; suffix — e.g. file.pdf → file_pdfa.pdf)" />
                        </StackPanel>
                    </RadioButton>
                    <DockPanel Margin="0,4,0,0">
                        <ui:Button x:Name="BrowseButton" Style="{StaticResource TertiaryFillButton}" DockPanel.Dock="Right" Content="Browse…" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowse" />
                        <RadioButton x:Name="FolderRadio" Content="Folder:" GroupName="Save" Checked="OnFolderChecked" />
                        <TextBlock x:Name="FolderText" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Not selected" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <CheckBox x:Name="PreserveStructureBox" Margin="20,4,0,0" IsChecked="True" Content="Preserve subfolder structure"
                              ToolTip="When saving to a chosen folder with subfolders included, recreate each file's subfolder path under the output folder instead of flattening all files together." />
                    <RadioButton x:Name="OverwriteRadio" Margin="0,4,0,0" Content="Overwrite the original (only after verification passes)" GroupName="Save" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="16,12" Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="PDF/A format" />
                    <ComboBox x:Name="FormatBox" SelectionChanged="OnFormatChanged" />
                    <TextBlock x:Name="FormatHint" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Status and actions, on a command-bar band  -->
        <Border Grid.Row="6" Margin="0,12,0,0" Padding="16,12" Background="{DynamicResource BandBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal">
                <ui:Button x:Name="LogButton" Style="{StaticResource TertiaryFillButton}" Content="Show log" Icon="{ui:SymbolIcon DocumentText24}" Click="OnShowLog" />
                <ui:Button x:Name="ConvertSelectedButton" Margin="8,0,0,0" Appearance="Secondary" Content="Convert selected" Icon="{ui:SymbolIcon PlayCircle24}" Click="OnConvertSelected" />
                <ui:Button x:Name="ConvertAllButton" Margin="8,0,0,0" Style="{StaticResource PrimaryFillButton}" Content="Convert all &amp; verify" Icon="{ui:SymbolIcon Play24}" Click="OnConvertAll" />
                <ui:Button x:Name="CancelButton" Margin="8,0,0,0" Appearance="Danger" Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Visibility="Collapsed" Click="OnCancel" />
            </StackPanel>
        </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
